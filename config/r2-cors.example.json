{
  "rules": [
    {
      "allowed": {
        "origins": ["https://xuan9527zz.github.io"],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": [
          "Content-Type",
          "Content-MD5",
          "Content-Length",
          "If-None-Match",
          "Cache-Control"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type",
        "Content-Disposition"
      ],
      "maxAgeSeconds": 600
    }
  ]
}
